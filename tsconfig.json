{
    "compilerOptions": {
        "outDir": "./dist/",
        "module": "ESNext",
        "target": "es2020",
        "allowJs": true,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "isolatedModules": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "allowUnreachableCode": false,
        "types": ["node", "vitest/globals"],
        "paths": {
            "api": ["./api/index.ts"],
            "api/*": ["./api/*"]
        }
    },
    "include": ["src"]
}
