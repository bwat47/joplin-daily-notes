{
    "$schema": "./node_modules/fallow/schema.json",
    "entry": ["src/index.ts", "src/calendar/webview/calendar.ts"],
    "supportEntry": ["src/**/*.test.ts"],
    "ignorePatterns": ["**/*.d.ts", "api/**"],
    "rules": {
        "complexity-crap": "off",
        "dev-dependencies-in-production": "off"
    },
    "health": {
        "maxCognitive": 15,
        "maxCyclomatic": 20
    }
}
