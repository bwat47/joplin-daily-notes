{
    "name": "joplin-plugin-daily-notes",
    "version": "1.1.0",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint src/ && npm run lint:dead-code && npm run lint:complexity",
        "lint:fix": "oxlint src/ --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint:dead-code": "fallow dead-code",
        "lint:complexity": "fallow health --complexity"
    },
    "license": "MIT",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.8.0",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint-plugin-regexp": "^3.3.3",
        "fallow": "^3.45.0",
        "jsdom": "^31.0.1",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2008",
        "typescript": "^7.0.2",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "@lezer/markdown": "^1.8.1",
        "dayjs": "^1.11.23"
    }
}
