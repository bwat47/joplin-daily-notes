{
    "name": "joplin-plugin-daily-notes",
    "version": "1.1.0",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/ test/",
        "lint:fix": "eslint src/ test/ --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "vitest run && node --test test/*.test.mjs",
        "test:watch": "vitest",
        "knip": "knip"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.1.0",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/eslint-plugin": "^1.6.27",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-tsdoc": "^0.5.4",
        "globals": "^14.0.0",
        "jsdom": "^30.1.3",
        "knip": "^6.42.1",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@lezer/markdown": "^1.8.1",
        "dayjs": "^1.11.23"
    },
    "overrides": {
        "eslint-plugin-tsdoc": {
            "@typescript-eslint/utils": "8.72.1"
        }
    }
}
