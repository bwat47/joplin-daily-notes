{
    "name": "joplin-plugin-daily-notes",
    "version": "1.1.0",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint src/ && npm run lint:dead-code && npm run lint:complexity",
        "lint:fix": "oxlint src/ --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint:dead-code": "fallow dead-code",
        "lint:complexity": "fallow health --complexity"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.1.0",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint-plugin-regexp": "^3.3.3",
        "fallow": "^3.43.0",
        "jsdom": "^30.1.3",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@lezer/markdown": "^1.8.1",
        "dayjs": "^1.11.23"
    }
}
